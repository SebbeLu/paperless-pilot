          },
          "priority": {
            "type": "integer",
            "title": "Priority"
          },
          "not_before": {
            "type": "string",
            "format": "date-time",
            "title": "Not Before"
          },
          "lease_owner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
