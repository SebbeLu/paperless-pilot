{
  "openapi": "3.1.0",
  "info": {
    "title": "paperless-pilot",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "description": "Lebenszeichen für Docker-Healthcheck und Monitoring; prüft keine Abhängigkeiten.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/status": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "System Status",
        "description": "Erreichbarkeit von Paperless und allen Ollama-Rechnern.",
        "operationId": "system_status_api_system_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "0.1.0"
          }
        },
        "type": "object",
        "title": "Health"
      },
      "HostStatus": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "reachable": {
            "type": "boolean",
            "title": "Reachable"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          },
          "models": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Models",
            "default": []
          },
          "problem": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Problem"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "name",
          "url",
          "reachable"
        ],
        "title": "HostStatus"
      },
      "PaperlessStatus": {
        "properties": {
          "reachable": {
            "type": "boolean",
            "title": "Reachable"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          },
          "documents_total": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Documents Total"
          },
          "documents_inbox": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Documents Inbox"
          },
          "problem": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Problem"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "reachable"
        ],
        "title": "PaperlessStatus"
      },
      "Problem": {
        "type": "string",
        "enum": [
          "unreachable",
          "auth"
        ]
      },
      "SystemStatus": {
        "properties": {
          "paperless": {
            "$ref": "#/components/schemas/PaperlessStatus"
          },
          "hosts": {
            "items": {
              "$ref": "#/components/schemas/HostStatus"
            },
            "type": "array",
            "title": "Hosts"
          }
        },
        "type": "object",
        "required": [
          "paperless",
          "hosts"
        ],
        "title": "SystemStatus"
      }
    }
  }
}
