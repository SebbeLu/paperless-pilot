    },
    "/api/taxonomy/sync": {
      "post": {
        "tags": [
          "taxonomy"
        ],
        "summary": "Sync Taxonomy",
        "description": "Verknüpft gleichnamige Objekte und legt fehlende in Paperless an.",
        "operationId": "sync_taxonomy_api_taxonomy_sync_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaxonomyState"
                }
              }
            }
          }
        }
      }
    },
    "/api/taxonomy/export": {
      "get": {
        "tags": [
          "taxonomy"
        ],
        "summary": "Export Taxonomy",
        "description": "Sicherung als JSON-Datei.",
        "operationId": "export_taxonomy_api_taxonomy_export_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Taxonomy"
                }
              }
            }
          }
        }
      }
    },
    "/api/paperless/lookups": {
      "get": {
        "tags": [
          "paperless"
        ],
        "summary": "Lookups",
        "operationId": "lookups_api_paperless_lookups_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lookups"
                }
              }
            }
          }
        }
      }
    },
    "/api/hosts": {
      "get": {
        "tags": [
          "hosts"
        ],
        "summary": "List Hosts",
        "description": "Rechner mit Erreichbarkeit, Modellen, Freigabe und laufendem Auftrag.",
        "operationId": "list_hosts_api_hosts_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/HostState"
                  },
                  "type": "array",
                  "title": "Response List Hosts Api Hosts Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/hosts/refresh": {
      "post": {
        "tags": [
          "hosts"
        ],
        "summary": "Refresh Hosts",
        "description": "Sofort neu prüfen statt auf den nächsten Takt zu warten.",
        "operationId": "refresh_hosts_api_hosts_refresh_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/HostState"
                  },
                  "type": "array",
                  "title": "Response Refresh Hosts Api Hosts Refresh Post"
                }
              }
            }
          }
        }
      }
    },
    "/api/hosts/{name}/rules": {
      "put": {
        "tags": [
          "hosts"
        ],
        "summary": "Update Rules",
        "description": "Pause, Zeitfenster und Home-Assistant-Regeln eines Rechners.",
        "operationId": "update_rules_api_hosts__name__rules_put",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HostRules"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HostState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "List Jobs",
        "operationId": "list_jobs_api_jobs_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/JobStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Job"
                  },
                  "title": "Response List Jobs Api Jobs Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/enqueue": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Enqueue",
        "description": "Posteingang (setzt den Todo-Tag in Paperless) oder einzelne Dokumente einreihen.",
        "operationId": "enqueue_api_jobs_enqueue_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnqueueRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnqueueResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}/retry": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Retry",
        "description": "Endgültig fehlgeschlagenen Auftrag erneut versuchen.",
        "operationId": "retry_api_jobs__job_id__retry_post",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Events",
        "description": "Server-Sent Events: die Oberfläche lädt betroffene Daten neu.",
        "operationId": "events_api_events_get",
        "responses": {
          "200": {
            "description": "Successful Response"
          }
        }
      }
    }
