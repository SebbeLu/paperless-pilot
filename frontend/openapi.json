      "HostState": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "online": {
            "type": "boolean",
            "title": "Online",
            "default": false
          },
          "version": {
            "anyOf": [
