  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "description": "Lebenszeichen für Docker-Healthcheck und Monitoring; prüft keine Abhängigkeiten.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/status": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "System Status",
        "description": "Erreichbarkeit von Paperless und allen Ollama-Rechnern.",
        "operationId": "system_status_api_system_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/taxonomy": {
      "get": {
        "tags": [
          "taxonomy"
        ],
        "summary": "Get Taxonomy",
        "description": "Taxonomie samt Abgleich mit Paperless.",
        "operationId": "get_taxonomy_api_taxonomy_get",
        "responses": {
          "200": {
            "description": "Successful Response",
