            "title": "Name"
          },
          "excluded": {
            "type": "boolean",
            "title": "Excluded"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "excluded"
        ],
        "title": "CorrespondentOption"
      },
      "Decision": {
