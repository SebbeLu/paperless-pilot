            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Models",
            "default": []
          },
          "has_model": {
            "type": "boolean",
            "title": "Has Model",
            "default": false
          },
          "problem": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Problem"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "checked_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checked At"
          },
          "rules": {
            "$ref": "#/components/schemas/HostRules",
            "default": {
              "paused": false,
              "idle_state": "off",
              "idle_minutes": 10,
              "block_state": "on"
            }
          },
          "decision": {
            "$ref": "#/components/schemas/Decision",
            "default": {
              "allowed": false,
              "reason": "Noch nicht geprüft"
            }
          },
          "entity_states": {
            "additionalProperties": {
              "$ref": "#/components/schemas/EntityState"
            },
            "type": "object",
            "title": "Entity States",
            "default": {}
          },
          "ha_available": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ha Available"
          },
          "busy_document_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Busy Document Id"
          },
          "processed": {
            "type": "integer",
            "title": "Processed",
            "default": 0
          },
          "last_duration_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Duration Ms"
          }
        },
        "type": "object",
        "required": [
          "name",
          "url",
          "model"
        ],
        "title": "HostState"
      },
      "HostStatus": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "reachable": {
            "type": "boolean",
            "title": "Reachable"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          },
          "models": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Models",
            "default": []
          },
          "problem": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Problem"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "name",
          "url",
          "reachable"
