              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaxonomyState"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "taxonomy"
        ],
        "summary": "Save Taxonomy",
        "description": "Speichert die Taxonomie (auch für den Import einer Sicherung).",
        "operationId": "save_taxonomy_api_taxonomy_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Taxonomy"
              }
            }
          },
          "required": true
